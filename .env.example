# Copy to .env for local use. NEVER commit real secrets. Production secrets come from the cloud secret manager.
TENSOR_ENV=local
TENSOR_DATABASE_URL=postgresql+psycopg://tensor_app:devpass@localhost/tensor
TENSOR_ADMIN_DATABASE_URL=postgresql+psycopg://tensor_owner:devpass@localhost/tensor
TENSOR_STORAGE_DIR=./var/objects
TENSOR_SCANNER=dev
TENSOR_AI_PROVIDER=mock
# TENSOR_AI_PROVIDER=anthropic
# TENSOR_ANTHROPIC_API_KEY=
# TENSOR_AI_MODEL=claude-sonnet-5-5
# Required outside local:
# TENSOR_OIDC_ISSUER=  TENSOR_OIDC_AUDIENCE=  TENSOR_OIDC_JWKS_URL=  TENSOR_SECRETS_KEY=
